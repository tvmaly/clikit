{
  "schema_version": "clikit.manifest-schema/v1",
  "required_fields": [
    "schema_version",
    "agent",
    "tool",
    "permissions",
    "output",
    "retry_behavior",
    "examples",
    "safety_notes"
  ],
  "tool_fields": ["name", "description", "command"],
  "permission_semantics": {
    "format": "shell command allowlist entries",
    "read_only_by_default": true,
    "write_operations_require_explicit_safety_notes": true
  },
  "allowed_operations": ["help", "list", "status", "inspect", "read-only-example"],
  "output_defaults": {
    "default": "json",
    "list": "jsonl",
    "errors": "structured-json"
  },
  "retry_field": "retry"
}
